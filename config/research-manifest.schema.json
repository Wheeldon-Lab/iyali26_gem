{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wheeldon-lab.example/schemas/iyali26-research-manifest-v1.json",
  "title": "iYali26 external research workspace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "research_root_name",
    "relocation_manifest_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at_utc": {
      "type": "string"
    },
    "research_root_name": {
      "type": "string",
      "minLength": 1
    },
    "relocation_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
